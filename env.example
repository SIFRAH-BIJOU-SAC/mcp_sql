# ── Conexión a SQL Server ────────────────────────────────────────────────
# Nombre EXACTO del driver ODBC instalado en el sistema. Verifica con:
#   odbcinst -q -d          (Linux/Mac)
# En Linux normalmente es "ODBC Driver 18 for SQL Server" (o 17 si es más viejo).
DB_DRIVER="ODBC Driver 18 for SQL Server"
DB_SERVER=172.17.0.141
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# Solo pon esto en "true" en desarrollo local con certificados autofirmados.
DB_TRUST_SERVER_CERT=false

# ── Timeouts (segundos) ───────────────────────────────────────────────────
# 1) Cuánto se espera para abrir la conexión.
DB_CONNECT_TIMEOUT_S=1000
# 2) Límite REAL de cuánto puede durar una consulta en SQL Server (tanto en
#    el camino rápido como en un job de segundo plano). Si esperas reportes
#    de varios minutos, súbelo (ej. 300 para 5 minutos).
DB_QUERY_TIMEOUT_S=120
# 3) NO es un límite de la consulta: es cuánto espera el AGENTE una respuesta
#    síncrona antes de que la consulta pase a correr en segundo plano como
#    "job" (ver README, sección "Consultas largas"). Puede quedarse bajo.
MCP_HARD_TIMEOUT_S=20

# ── Jobs en segundo plano ─────────────────────────────────────────────────
# Cuánto se conserva en memoria el resultado de un job ya terminado, para que
# el agente lo pueda recoger con get_query_result (segundos).
MCP_JOB_RESULT_TTL_S=1800

# ── Límites de filas ──────────────────────────────────────────────────────
MCP_DEFAULT_MAX_ROWS=200
MCP_ABSOLUTE_MAX_ROWS=5000
MCP_EXPORT_MAX_ROWS=50000

# ── Concurrencia (consultas simultáneas permitidas contra SQL Server) ────
MCP_MAX_CONCURRENT_QUERIES=4

# ── Seguridad ──────────────────────────────────────────────────────────────
# Déjalo en "false" salvo que de verdad necesites permitir INSERT/UPDATE/DELETE.
# La protección real debería venir de un login de SQL Server de solo SELECT
# (ver README.md, sección "Seguridad").
ALLOW_WRITE_QUERIES=false

# ── Exportación a CSV ────────────────────────────────────────────────────
MCP_EXPORT_DIR=../exports
# Los CSV se borran al servirse (fetch_export_csv) o a los N segundos de creados
MCP_EXPORT_TTL_S=600
# Tope de tamano para devolver un CSV en linea con fetch_export_csv (6 MB; si es mayor, se lee desde disco)
MCP_EXPORT_FETCH_MAX_BYTES=6000000

# ── Transporte del servidor MCP ──────────────────────────────────────────
# stdio -> Claude Desktop / Claude Code (proceso local, un usuario a la vez)
# http  -> servidor de red, para que varios agentes/usuarios se conecten
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
